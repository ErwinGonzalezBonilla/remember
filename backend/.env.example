# Base de datos: SQLite para desarrollo, PostgreSQL en producción (Railway)
DATABASE_URL=sqlite:///./rehomi.db
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/rehomi

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-secreto-largo
ACCESS_TOKEN_MINUTES=10080

# URL del frontend (CORS y enlaces de recuperación). Varias separadas por coma.
# En producción: FRONTEND_URL=https://rehomi-xxx.vercel.app
FRONTEND_URL=http://localhost:5173

# Multimedia: si defines CLOUDINARY_URL se usa Cloudinary; si no, disco local (./uploads)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
MAX_UPLOAD_MB=25

# Correos: Resend (recomendado) o SMTP. Si no defines ninguno, en local se escriben en la consola.
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicacion
# MAIL_FROM=REHOMI <hola@tudominio.com>

# Clave que usa Vercel Cron para llamar a /api/cron/capsules (aviso de cápsulas abiertas)
# CRON_SECRET=otra-clave-larga

# ---------- Producción (Railway) ----------
# DATABASE_URL  → ${{Postgres.DATABASE_URL}} (referencia a la base de datos de Railway)
# SECRET_KEY    → una clave nueva y larga (no la de tu ordenador)
# FRONTEND_URL  → https://tu-app.vercel.app,http://localhost:5173
# UPLOAD_DIR    → /data/uploads  (carpeta dentro del volumen de Railway)
